# Ein langer Flur. Je weiter du gehst, desto höher wird die Decke.
# Die Leuchten sind weit auseinander, eine flackert.

[room]
baseboard = 0.08, #5a4626
name = Flur
height = 2.5, 4.0       # vorne 2,5 m, am anderen Ende 4 m
slope = east            # nach Osten (rechts im Grundriss) wird sie höher

[map]
######################
#....................#
1....F.........L.....2
#....................#
######################

[F]
light = #ffe7b0
power = 0.7
flicker = 1

[L]
light = #ffe7b0
power = 0.6

[2]
door = saeulengang 1
