[M]
model = statues/athena.glb   # Athena Giustiniani, Abguss im SMK Kopenhagen, gemeinfrei
height = 6
rotation = 180            # zum Eingang
material = marble

[K]
light = #f4f6ff
power = 3
size = 1.6, 1.6           # eine große Leuchte: weiche Schatten

[L]
light = #ffd9a0
power = 0.6
size = 1.2, 1.2

[S]
block = 0.9, 6, 0.9
