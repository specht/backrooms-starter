# Eine Halle aus Marmor unter einem hohen Satteldach. Zwei Reihen Säulen,
# und ganz hinten, im einzigen hellen Licht, steht Athena.

[room]
name = Halle
height = 6, 11
slope = gable
walls = marble
carpet = #5a4d30

[map]
